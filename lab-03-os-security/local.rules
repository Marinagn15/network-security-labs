# local.rules — Snort3 detection rules
# Lab 03: OS Security | Internet Services and Protocol Security
# Universidad de Málaga — Grado en Ciberseguridad e IA

# ─────────────────────────────────────────────
# RULE 1: MitM / ARP Spoofing detection
# Triggers when a single source sends 5+ ARP replies in 10 seconds
# ─────────────────────────────────────────────
alert arp any any -> any any (
    msg:"MITM - Possible ARP Spoofing";
    arp_opcode: 2;
    detection_filter: track by_src, count 5, seconds 10;
    sid:1000001;
    rev:1;
)

# ─────────────────────────────────────────────
# RULE 2: Packet injection — abnormal TCP flags (SYN+FIN)
# SYN and FIN set simultaneously is invalid and indicates crafted packets
# ─────────────────────────────────────────────
alert tcp any any -> any any (
    msg:"Packet injection - abnormal TCP flags (SYN+FIN)";
    flags: SF;
    sid:1000002;
    rev:1;
)

# ─────────────────────────────────────────────
# RULE 3: Packet injection — stateless TCP
# Detects TCP packets that don't belong to any tracked session
# ─────────────────────────────────────────────
alert tcp any any -> any any (
    msg:"Packet injection - stateless TCP flow";
    flow: stateless;
    sid:1000003;
    rev:1;
)

# ─────────────────────────────────────────────
# RULE 4: SYN Flood detection
# More than 20 SYN packets per second from a single source
# ─────────────────────────────────────────────
alert tcp any any -> any 80 (
    msg:"DoS - SYN Flood attack detected";
    flags: S;
    detection_filter: track by_src, count 20, seconds 1;
    sid:1000004;
    rev:1;
)

# ─────────────────────────────────────────────
# RULE 5: ICMP flood / Smurf attack detection
# High rate of ICMP echo requests from a single source
# ─────────────────────────────────────────────
alert icmp any any -> any any (
    msg:"DoS - ICMP flood / Smurf attack detected";
    itype: 8;
    detection_filter: track by_src, count 30, seconds 1;
    sid:1000005;
    rev:1;
)

# ─────────────────────────────────────────────
# RULE 6: Hydra SSH brute force detection
# More than 5 SSH connection attempts in 30 seconds
# ─────────────────────────────────────────────
alert tcp any any -> any 22 (
    msg:"Brute Force - SSH login attempts (possible Hydra)";
    flags: S;
    detection_filter: track by_src, count 5, seconds 30;
    sid:1000006;
    rev:1;
)
